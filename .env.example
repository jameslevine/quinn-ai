# Quinn - Environment Variables
# Copy this file to .env.local and fill in the values

# ===========================================
# AWS Configuration
# ===========================================
AWS_REGION=eu-west-2
AWS_ACCOUNT_ID=

# ===========================================
# Cognito Configuration
# ===========================================
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=

# ===========================================
# API Configuration
# ===========================================
API_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001

# ===========================================
# AWS Bedrock (AI)
# ===========================================
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REGION=eu-west-2

# ===========================================
# Email Integration (Phase 1)
# ===========================================
# Gmail OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# Outlook OAuth
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=

# ===========================================
# Voice/SMS Integration (Phase 2)
# ===========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ===========================================
# Banking Integration (Phase 3)
# ===========================================
# TrueLayer
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=

# Monzo
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=
MONZO_REDIRECT_URI=

# ===========================================
# Food Integration (Phase 4)
# ===========================================
# Deliveroo (if API available)
DELIVEROO_API_KEY=

# ===========================================
# Development Settings
# ===========================================
NODE_ENV=development
LOG_LEVEL=debug

# ===========================================
# Frontend Configuration
# ===========================================
VITE_APP_NAME=Quinn
VITE_APP_TAGLINE="Quinn knows what to do"

# ===========================================
# Mobile Configuration (Expo)
# ===========================================
EXPO_PUBLIC_API_URL=http://localhost:3001
